<?xml version="1.0" encoding="utf-8"?>
<!-- Field screen: channel, talk, quick map points. Setup lives in Settings (menu). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="28dp">

    <include layout="@layout/main_controls" />

    <!-- Spare space sits above PTT; the button is sized to about a quarter of the screen in code. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/ptt"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/ptt_background"
        android:minHeight="120dp"
        android:text="@string/ptt"
        android:textColor="#ffffff"
        android:textSize="28sp"
        android:textStyle="bold" />
</LinearLayout>
