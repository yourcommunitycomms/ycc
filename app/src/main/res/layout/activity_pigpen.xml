<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/sheet"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <Spinner
            android:id="@+id/row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:id="@+id/key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:typeface="monospace" />

    <RadioGroup
        android:id="@+id/mode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/mode_encode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/pig_encode" />

        <RadioButton
            android:id="@+id/mode_decode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pig_decode" />
    </RadioGroup>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/plain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pig_plain_hint"
                android:inputType="textCapCharacters|textNoSuggestions|textMultiLine" />

            <org.communitycomms.app.dryad.PigpenStripView
                android:id="@+id/strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />

            <TextView
                android:id="@+id/decoded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textIsSelectable="true"
                android:textSize="22sp"
                android:typeface="monospace" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <org.communitycomms.app.dryad.PigpenKeyboardView
            android:id="@+id/keyboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/space" style="@style/SmallButton" android:text="@string/pig_space" />
            <Button android:id="@+id/backspace" style="@style/SmallButton" android:text="@string/pig_back" />
            <Button android:id="@+id/clear" style="@style/SmallButton" android:text="@string/pig_clear" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
