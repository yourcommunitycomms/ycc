<?xml version="1.0" encoding="utf-8"?>
<!-- Map home screen: mostly map and POIs, a smaller PTT and a few shortcuts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:paddingTop="4dp"
    android:paddingBottom="28dp">

    <include layout="@layout/main_map_top" />

    <FrameLayout
        android:id="@+id/map_holder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include layout="@layout/main_map_bottom" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/call"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="@string/call"
            android:textAllCaps="false"
            android:textSize="13sp" />

        <Button
            android:id="@+id/ptt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/ptt_background"
            android:text="@string/ptt"
            android:textColor="#ffffff"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/radio_silent"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:text="@string/radio_silent_off"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <include layout="@layout/main_map_hidden" />
</LinearLayout>
