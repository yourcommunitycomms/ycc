<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <RadioGroup
            android:id="@+id/slot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/slot_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_a" />

            <RadioButton
                android:id="@+id/slot_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_b" />

            <RadioButton
                android:id="@+id/slot_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_public_short" />

            <RadioButton
                android:id="@+id/slot_openmanet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_openmanet_short" />
        </RadioGroup>

        <Button
            android:id="@+id/join"
            style="@style/CompactButton"
            android:text="@string/channels_button" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textSize="12sp"
        android:textStyle="bold" />
</merge>
