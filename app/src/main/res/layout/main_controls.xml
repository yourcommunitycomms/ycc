<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

        <RadioGroup
            android:id="@+id/slot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/slot_a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_a" />

            <RadioButton
                android:id="@+id/slot_b"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_b" />

            <RadioButton
                android:id="@+id/slot_public"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_public" />

            <RadioButton
                android:id="@+id/slot_openmanet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/slot_openmanet" />
        </RadioGroup>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textStyle="bold" />

        <Button
            android:id="@+id/join"
            style="@style/CompactButton"
            android:text="@string/channels_button" />
    </LinearLayout>

    <include layout="@layout/main_contacts_row" />

    <include layout="@layout/ack_bar" />

    <TextView
        android:id="@+id/quick_label"
        style="@style/Label"
        android:text="@string/quick_poi" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/quick_1"
            style="@style/SmallButton"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/quick_2"
            style="@style/SmallButton"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/quick_3"
            style="@style/SmallButton"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/quick_4"
            style="@style/SmallButton"
            android:layout_height="match_parent" />
    </LinearLayout>

    <!-- Simple modes (Scouts, Staff, 4WD…): a second row of their quick buttons. -->
    <LinearLayout
        android:id="@+id/quick_row2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/quick_5"
            style="@style/SmallButton"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/quick_6"
            style="@style/SmallButton"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/quick_7"
            style="@style/SmallButton"
            android:layout_height="match_parent" />

        <Button
            android:id="@+id/quick_8"
            style="@style/SmallButton"
            android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/share_loc"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="@string/share_loc" />

        <Button
            android:id="@+id/call"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/call" />

        <Button
            android:id="@+id/radio_silent"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/radio_silent_off" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <Button
            android:id="@+id/chat"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/chat" />

        <Button
            android:id="@+id/reports"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/reports" />

        <Button
            android:id="@+id/map"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/map" />

        <Button
            android:id="@+id/lock"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/lock" />

        <Button
            android:id="@+id/black_screen"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:text="@string/black_screen"
            android:visibility="gone" />
    </LinearLayout>
</merge>
