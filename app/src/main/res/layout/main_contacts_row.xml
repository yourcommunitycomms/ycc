<?xml version="1.0" encoding="utf-8"?>
<!-- Contacts (n online, red when nobody), my status (Available / Away / Stealth), camera shortcut. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/contacts"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:text="@string/contacts" />

        <Button
            android:id="@+id/my_status"
            style="@style/SmallButton"
            android:layout_height="match_parent"
            android:layout_weight="2"
            android:text="@string/status_available" />

        <!-- DRYAD challenge and response (two heads facing); Advanced mode only. -->
        <ImageButton
            android:id="@+id/challenge_btn"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="Challenge and response"
            android:scaleType="center"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/camera"
            android:layout_width="44dp"
            android:layout_height="match_parent"
            android:contentDescription="@string/camera"
            android:scaleType="center"
            android:src="@drawable/ic_camera" />
    </LinearLayout>
</merge>
